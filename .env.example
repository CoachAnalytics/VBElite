# Leave DATABASE_URL unset for local development: the app uses an embedded
# Postgres in ./.data. In production, connecting Neon (or Supabase) through
# Vercel's Storage tab sets this automatically.
# DATABASE_URL=postgres://user:password@host:5432/vbelite

# Optional. The first account created on a new site becomes its admin, and
# admins add others on the /admin page. Emails listed here are always admins,
# which is a way back in if every admin login is lost.
# ADMIN_EMAILS=you@example.com
